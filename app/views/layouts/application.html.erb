<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= safe_join([content_for(:title).presence, "Timeframe"].compact, " · ") %></title>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="256x256" href="/sun-angle.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#f1f3f5">
    <%= stylesheet_link_tag "application_tailwind" %>
    <link rel="stylesheet" href="/css/mdi/materialdesignicons.css">
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-white font-body text-ink antialiased">
    <nav class="mb-4 bg-surface">
      <div class="mx-auto flex w-full max-w-[1140px] items-center px-3 py-2">
        <a class="inline-flex items-center gap-1.5 text-xl font-bold leading-none text-black no-underline" style="font-family: 'Lato', system-ui, sans-serif" href="/">
          <i class="mdi mdi-sun-angle text-2xl leading-none" aria-hidden="true"></i>
          <span>timeframe</span>
        </a>
        <ul class="ml-auto flex items-center gap-2">
          <li>
            <a class="block px-2 py-1 text-black no-underline hover:opacity-70" href="/status">Status</a>
          </li>
        </ul>
      </div>
    </nav>

    <div class="mx-auto w-full max-w-[1140px] px-3">
      <% flash.each do |key, value| %>
        <div class="relative mb-3 flex items-center gap-3 rounded-md border py-3 pl-4 pr-10 <%= key == 'notice' ? 'border-green-200 bg-green-50 text-green-800' : 'border-red-200 bg-red-50 text-red-800' %>" role="alert" data-controller="alert">
          <span class="mr-auto"><%= value %></span>
          <button type="button" class="absolute right-2 top-1/2 -translate-y-1/2 text-xl leading-none opacity-60 hover:opacity-100" data-action="alert#dismiss" aria-label="Close">&times;</button>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <footer class="mx-auto mb-3 mt-4 w-full max-w-[1140px] px-3 text-center text-sm text-gray-500">
      <a href="https://github.com/timeframe/timeframe" class="text-gray-500 no-underline hover:underline" target="_blank" rel="noopener">GitHub</a>
    </footer>
  </body>
</html>
