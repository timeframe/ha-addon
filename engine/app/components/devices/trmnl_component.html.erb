<%= render Devices::StatusBarComponent.new(view_object: @view_object) %>
<style>
  html { font-size: 16px; }
</style>
<% if @view_object.dig(:configuration, "show_current_day") == "true" %>
  <div style="clear: both; display: flex; justify-content: space-between; align-items: baseline; font-weight: 700; font-size: 2rem; line-height: 1; margin-bottom: .75rem;">
    <div><%= @view_object[:current_time].strftime("%A, %b. %-d") %></div>
    <div style="text-align: right;"><%= @view_object[:current_temperature] %></div>
  </div>
  <hr style="margin: .5rem 0 1rem; border: none; background-color: #ccc; height: 2px;">
<% end %>
<%= render Devices::TimelineComponent.new(view_object: @view_object) %>

<%= render Devices::AttributionComponent.new(view_object: @view_object, offset: "4px") %>
