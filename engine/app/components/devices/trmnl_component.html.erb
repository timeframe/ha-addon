<%= render Devices::StatusBarComponent.new(view_object: @view_object) %>
<% unless @view_object[:private_mode] %>
  <style>
    html { font-size: 16px; --timeline-day-name-size: 1rem; --timeline-day-name-line-height: normal; }
    .timeline-day-header--compact { display: flex; align-items: baseline; gap: .25rem; }
    .timeline-day-header--compact .timeline-day-weather-icon { font-size: 1.25rem; font-weight: 700; }
    .timeline-day-header--compact .timeline-day-summary { margin-left: auto; text-align: right; }
    .timeline-day-daily { border-collapse: collapse; }
    .timeline-day-daily td { padding-top: 0; padding-bottom: 0; }
  </style>
  <%= render Devices::TimelineComponent.new(view_object: @view_object, compact_header: true) %>
<% end %>

<div class="timestamp" style="position: absolute; bottom: 4px; right: 4px; font-family: 'Pixelify Sans', monospace; font-size: 8px; -webkit-font-smoothing: none; z-index: 10; writing-mode: vertical-rl; text-orientation: mixed;">
  Noun Project icons. <%= @view_object[:attribution] if @view_object[:attribution].present? %> <%= @view_object[:timestamp] %>
</div>
