<style>
  html, body { margin: 0; padding: 0; }
  .charge-reminder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100vw;
    height: 100vh;
    box-sizing: border-box;
    padding: clamp(1rem, 4vmin, 2rem);
    text-align: center;
    font-family: 'Lato', sans-serif;
    color: #000;
    overflow: hidden;
  }
  .charge-reminder i { font-size: clamp(3rem, 22vmin, 12rem); line-height: 1; }
  .charge-reminder-status { display: flex; align-items: center; justify-content: center; gap: clamp(.5rem, 2vmin, 1rem); max-width: 100%; }
  .charge-reminder-level { font-size: clamp(2rem, 12vmin, 6rem); font-weight: 700; line-height: 1; }
  .charge-reminder-title { font-size: clamp(1.5rem, 6vmin, 3rem); font-weight: 700; margin-top: 1.5rem; line-height: 1.1; }
  .charge-reminder-hint { font-size: clamp(1rem, 4vmin, 1.75rem); margin-top: clamp(.5rem, 2vmin, 1rem); max-width: 22em; line-height: 1.3; }
</style>

<div class="charge-reminder">
  <div class="charge-reminder-status">
    <i class="mdi mdi-battery-alert-variant-outline"></i>
    <% if @battery %>
      <div class="charge-reminder-level"><%= @battery[:level] %>%</div>
    <% end %>
  </div>
  <div class="charge-reminder-hint">Plug in your Timeframe device to recharge.</div>
</div>
