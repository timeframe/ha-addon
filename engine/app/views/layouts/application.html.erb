<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= safe_join([content_for(:title).presence, "Timeframe"].compact, " · ") %></title>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="256x256" href="/sun-angle.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#f1f3f5">
    <link rel="stylesheet" href="/css/mdi/materialdesignicons.css">
  </head>
  <body class="bg-white text-ink antialiased">
    <nav class="mb-4 bg-surface">
      <div class="mx-auto flex w-full max-w-[1140px] items-center px-3 py-2">
        <a class="inline-flex items-center gap-1.5 text-xl font-bold leading-none text-black no-underline" href="/">
          <i class="mdi mdi-sun-angle text-2xl leading-none" aria-hidden="true"></i>
          <span>timeframe</span>
        </a>
        <%= yield :navbar %>
      </div>
    </nav>

    <div class="mx-auto w-full max-w-[1140px] px-3">
      <% flash.each do |key, value| %>
        <div class="mb-3 rounded-md border px-4 py-3 <%= key == 'notice' ? 'border-green-200 bg-green-50 text-green-800' : 'border-red-200 bg-red-50 text-red-800' %>" role="alert">
          <%= value %>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <footer class="mx-auto mb-3 mt-4 w-full max-w-[1140px] px-3 text-center text-sm text-gray-500">
      <a href="https://github.com/timeframe/timeframe" class="text-gray-500 no-underline hover:underline" target="_blank" rel="noopener">GitHub</a>
      <%= yield :footer %>
    </footer>
  </body>
</html>
