<%#
  Shared, framework-neutral row for a customizable calendar event: a bulk-select
  checkbox, the event, a three-dot menu (Hide/Unhide + Edit), and a native
  <dialog> edit form. Uses raw Tailwind utilities (generated by each host bundle
  that @sources the engine views) and the shared dropdown/modal Stimulus
  controllers, so both hosts can render it without copying markup or CSS.

  Locals:
    update_url        - form action for saving/clearing the customization
    calendar_id       - owning calendar id (drives client-side filtering)
    customization_key - stable per-event key
    bulk_value        - value for the bulk-select checkbox (host-defined id)
    title             - display title (customization applied)
    icon              - display mdi icon name, without the "mdi-" prefix
    time_text         - preformatted date/time string
    calendar_name     - owning calendar name
    hidden            - whether the event is currently hidden
    current_icon      - stored icon as an mdi class (e.g. "mdi-cake-variant") or nil
    current_title     - stored title override
    hide_url          - form action for the show/hide toggle
    devices           - [{id:, name:}] for the per-device visibility checkboxes
    only_ids          - selected device ids (strings) for per-device visibility
    banner_enabled    - whether the banner is on
    banner_message    - stored banner message
    countdown_days    - stored countdown days, or nil
    default_icon      - the calendar's default icon as an mdi class, or nil
%>
<% picker_id = "evt-icon-#{Digest::MD5.hexdigest(bulk_value.to_s)[0, 12]}" %>
<% default_icon = local_assigns.fetch(:default_icon, nil) %>
<div data-bulk-row data-calendar-id="<%= calendar_id %>" data-event-search="<%= [title, calendar_name].join(" ").downcase %>"
     class="flex items-center justify-between gap-2 border-b border-ink/10 py-2 last:border-b-0 <%= "opacity-50 tf-hidden-event" if hidden %>">
  <div class="flex min-w-0 items-center gap-2">
    <input type="checkbox" class="tf-check flex-shrink-0" data-bulk-checkbox value="<%= bulk_value %>" aria-label="Select <%= title %>">
    <span class="w-6 flex-shrink-0 text-center"><i class="mdi mdi-<%= icon %>" aria-hidden="true"></i></span>
    <div class="min-w-0">
      <div class="truncate text-sm"><%= title %></div>
      <div class="truncate text-xs text-gray-500"><%= time_text %> &middot; <%= calendar_name %></div>
    </div>
  </div>

  <div class="relative flex flex-shrink-0 items-center gap-1" data-controller="dropdown modal" data-action="keydown.esc->dropdown#hide">
    <% if hidden %><span class="rounded-full bg-ink/10 px-2 py-0.5 text-xs font-medium text-ink">Hidden</span><% end %>
    <button type="button" class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-md border border-ink/30 hover:bg-ink/5"
      data-dropdown-target="button" data-action="dropdown#toggle" aria-expanded="false" aria-haspopup="true" aria-label="Event actions">
      <span class="mdi mdi-dots-vertical"></span>
    </button>

    <ul class="absolute right-0 top-full z-50 m-0 mt-1 hidden min-w-[11rem] list-none rounded-md border border-ink/10 bg-white p-0 py-1 shadow-lg" data-dropdown-target="menu">
      <li>
        <%= form_with url: hide_url, method: :patch do %>
          <input type="hidden" name="calendar_id" value="<%= calendar_id %>">
          <input type="hidden" name="customization_key" value="<%= customization_key %>">
          <input type="hidden" name="omit" value="<%= hidden ? "0" : "1" %>">
          <button type="submit" class="flex min-h-11 w-full items-center gap-2 px-4 py-1.5 text-left text-ink hover:bg-black/5" data-action="dropdown#hide">
            <span class="mdi <%= hidden ? "mdi-eye" : "mdi-eye-off" %>"></span><%= hidden ? "Unhide" : "Hide" %>
          </button>
        <% end %>
      </li>
      <li>
        <button type="button" class="flex min-h-11 w-full items-center gap-2 px-4 py-1.5 text-left text-ink hover:bg-black/5" data-action="modal#open dropdown#hide">
          <span class="mdi mdi-pencil"></span>Edit
        </button>
      </li>
    </ul>

    <dialog class="w-[min(32rem,92vw)] max-h-[85vh] overflow-auto rounded-lg border-0 p-0 text-left text-ink shadow-xl" data-modal-target="dialog" data-action="click->modal#backdropClose">
      <%= form_with url: update_url, method: :patch do %>
        <input type="hidden" name="calendar_id" value="<%= calendar_id %>">
        <input type="hidden" name="customization_key" value="<%= customization_key %>">
        <div class="flex items-center justify-between border-b border-ink/10 px-4 py-3">
          <h3 class="text-lg font-semibold">Edit event</h3>
          <button type="button" class="flex min-h-11 min-w-11 items-center justify-center border-0 bg-transparent text-xl leading-none opacity-60 hover:opacity-100" data-action="modal#close" aria-label="Close">&times;</button>
        </div>
        <div class="space-y-4 p-4">
          <div>
            <label class="mb-2 block font-bold">Icon</label>
            <% reset_icon_button = capture do %>
              <button type="button" class="tf-ip-suggest<%= " hidden" unless current_icon.present? %>"
                data-icon-default="<%= picker_id %>" data-default-icon="<%= default_icon %>">
                <span class="mdi mdi-backup-restore"></span>
                <span>Reset icon</span>
              </button>
            <% end %>
            <%= render "calendars/icon_picker", field_name: "customization[icon]", picker_id: picker_id, current_icon: current_icon, preview_icon: current_icon.presence || default_icon, inline: true, suggest_kind: "event", suggest_from: "#{picker_id}-title", suggest_extra: reset_icon_button %>
          </div>
          <div>
            <label class="mb-1 block font-bold">Title override</label>
            <input type="text" id="<%= picker_id %>-title" name="customization[title_override]" class="tf-input" value="<%= current_title %>" placeholder="<%= title %>">
            <p class="mt-1 text-xs text-gray-500">Shown on Timeframe only. Leave blank to use the calendar's title.</p>
          </div>
          <% if devices.size > 1 %>
          <div>
            <label class="mb-2 block font-bold">Only show on specific devices</label>
            <p class="mb-2 text-sm text-gray-500">Leave all unchecked to show on every device.</p>
            <% devices.each do |device| %>
              <label class="mb-1 flex items-center gap-2">
                <input type="checkbox" class="tf-check" name="device_ids[]" value="<%= device[:id] %>" <% if only_ids.include?(device[:id].to_s) %>checked<% end %>>
                <span><%= device[:name] %></span>
              </label>
            <% end %>
          </div>
          <% end %>
          <div>
            <label class="mb-2 block font-bold">Banner</label>
            <input type="hidden" name="banner" value="0">
            <label class="mb-2 flex items-center gap-2">
              <input type="checkbox" class="tf-check" name="banner" value="1" <% if banner_enabled %>checked<% end %>>
              <span>Show this event as a banner during the event</span>
            </label>
            <textarea class="tf-textarea" name="message" rows="2" placeholder="Optional banner message"><%= banner_message %></textarea>
          </div>
          <%= render "dashboard/countdown_fields", id_prefix: picker_id, enabled: countdown_days.present?, days: countdown_days || 7 %>
        </div>
        <div class="flex justify-end gap-2 border-t border-ink/10 px-4 py-3">
          <button type="button" class="tf-btn tf-btn-outline tf-btn-sm" data-action="modal#close">Cancel</button>
          <%= submit_tag "Save", class: "tf-btn tf-btn-primary tf-btn-sm" %>
        </div>
      <% end %>
    </dialog>
  </div>
</div>

<script>
  (function () {
    // "Reset icon" clears the icon picker's override input and restores its
    // preview to the calendar's default icon. Hidden while there is no override.
    var resetBtn = document.querySelector('[data-icon-default="<%= picker_id %>"]');
    if (!resetBtn) return;
    var input = document.getElementById("<%= picker_id %>-input");
    var preview = document.getElementById("<%= picker_id %>-preview");
    function syncResetVisibility() {
      if (input) resetBtn.classList.toggle("hidden", input.value.trim() === "");
    }
    if (input) {
      input.addEventListener("input", syncResetVisibility);
      input.addEventListener("change", syncResetVisibility);
      syncResetVisibility();
    }
    resetBtn.addEventListener("click", function () {
      var defaultIcon = resetBtn.getAttribute("data-default-icon") || "";
      if (input) {
        input.value = "";
        input.dispatchEvent(new Event("input", { bubbles: true }));
      }
      if (preview) {
        var m = defaultIcon.match(/^mdi-alpha-([a-z])$/i);
        if (m) {
          preview.className = "cal-letter";
          preview.textContent = m[1].toUpperCase();
        } else {
          preview.className = "mdi " + (defaultIcon || "mdi-calendar-blank-outline");
          preview.textContent = "";
        }
      }
    });
  })();
</script>
