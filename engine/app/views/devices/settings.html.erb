<% content_for :title, @device.name %>
<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <% if defined?(current_user) && current_user&.is_admin? %>
      <% admin_user = @device.account&.users&.first %>
      <% if admin_user %>
        <p class="mb-1"><%= link_to "← Back to #{admin_user.email}", admin_user_path(admin_user), class: "text-decoration-none small" %></p>
      <% end %>
    <% end %>
    <div class="d-flex align-items-center mb-4">
      <h3 class="mb-0"><%= @device.name %></h3>
      <span class="text-body-tertiary ms-2" style="font-size: 0.85rem;"><%= @device.model_name_label %></span>
    </div>

    <%# Preview + Screenshot %>
    <% has_screenshot = @device.screenshotted? && @device.cached_image.present? %>
    <div class="card mb-3">
      <div class="card-header preview-tabs-header">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button type="button" class="nav-link active" id="preview-tab" data-bs-toggle="tab" data-bs-target="#preview-pane" role="tab" aria-controls="preview-pane" aria-selected="true">Preview</button>
          </li>
          <% if has_screenshot %>
            <li class="nav-item" role="presentation">
              <button type="button" class="nav-link" id="screenshot-tab" data-bs-toggle="tab" data-bs-target="#screenshot-pane" role="tab" aria-controls="screenshot-pane" aria-selected="false">Screenshot</button>
            </li>
          <% end %>
        </ul>
      </div>
      <style>
        .preview-tabs-header .nav-link { color: var(--bs-body-color); }
        .preview-tabs-header .nav-link:hover,
        .preview-tabs-header .nav-link:focus { color: var(--bs-body-color); }
        .preview-tabs-header .nav-link.active { color: var(--bs-body-color); }
      </style>
      <div class="tab-content">
        <div class="tab-pane fade show active" id="preview-pane" role="tabpanel" aria-labelledby="preview-tab">
          <div class="card-body p-0">
            <div id="preview-container" style="position: relative; background: white; overflow: hidden; width: 100%;">
              <iframe
                id="preview-iframe"
                src="<%= preview_frame_account_location_device_path(@account, @location, @device) %>"
                width="<%= @device.display_width %>"
                height="<%= @device.display_height %>"
                scrolling="no"
                style="border: none; position: absolute; top: 0; left: 0; width: <%= @device.display_width %>px; height: <%= @device.display_height %>px; transform-origin: top left;"
              ></iframe>
            </div>
          </div>
          <div class="card-footer py-2">
            <div class="d-flex flex-wrap align-items-center gap-1">
              <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-secondary" id="preview-prev" title="Previous day">&larr;</button>
                <button type="button" class="btn btn-outline-secondary" id="preview-today">Today</button>
                <button type="button" class="btn btn-outline-secondary" id="preview-next" title="Next day">&rarr;</button>
              </div>
              <input type="date" class="form-control form-control-sm w-auto flex-shrink-0" id="preview-date" value="<%= @preview_now.to_date.to_s %>">
              <input type="time" class="form-control form-control-sm w-auto flex-shrink-0" id="preview-time" value="<%= @preview_now.strftime("%H:%M") %>">
            </div>
          </div>
        </div>
        <% if has_screenshot %>
          <div class="tab-pane fade" id="screenshot-pane" role="tabpanel" aria-labelledby="screenshot-tab">
            <div class="card-body p-2">
              <div class="d-flex align-items-center justify-content-center" style="background: #f0f0f0; border-radius: .25rem; overflow: hidden; min-height: 100px;" id="screenshot-container">
                <img src="<%= screenshot_account_location_device_path(@account, @location, @device) %>" alt="<%= @device.name %>" style="max-width: 100%; height: auto;" id="screenshot-img">
                <div id="screenshot-loading" style="display: none;" class="text-body-secondary small py-4">Regenerating screenshot&hellip;</div>
              </div>
            </div>
            <div class="card-footer py-2 d-flex justify-content-end">
              <button type="button" class="btn btn-outline-secondary btn-sm" id="regen-screenshot-btn">Regenerate</button>
            </div>
          </div>
        <% end %>
      </div>
      <script>
        (function() {
          var basePath = '<%= preview_frame_account_location_device_path(@account, @location, @device) %>';
          var dateInput = document.getElementById('preview-date');
          var timeInput = document.getElementById('preview-time');
          var prevBtn = document.getElementById('preview-prev');
          var nextBtn = document.getElementById('preview-next');
          var todayBtn = document.getElementById('preview-today');
          var container = document.getElementById('preview-container');
          var iframe = document.getElementById('preview-iframe');
          var deviceWidth = <%= @device.display_width %>;
          var deviceHeight = <%= @device.display_height %>;
          function updatePreview() {
            var at = dateInput.value + 'T' + timeInput.value + ':00';
            iframe.src = basePath + '?at=' + encodeURIComponent(at);
          }
          function shiftDate(days) {
            var d = new Date(dateInput.value + 'T12:00:00');
            d.setDate(d.getDate() + days);
            dateInput.value = d.toISOString().slice(0, 10);
            updatePreview();
          }
          prevBtn.addEventListener('click', function() { shiftDate(-1); });
          nextBtn.addEventListener('click', function() { shiftDate(1); });
          todayBtn.addEventListener('click', function() {
            dateInput.value = '<%= @preview_now.to_date.to_s %>';
            timeInput.value = '<%= @preview_now.strftime("%H:%M") %>';
            updatePreview();
          });
          dateInput.addEventListener('change', updatePreview);
          timeInput.addEventListener('change', updatePreview);
          function scaleToFit() {
            var availWidth = container.parentElement.clientWidth;
            var scale = availWidth / deviceWidth;
            iframe.style.transform = 'scale(' + scale + ')';
            container.style.height = Math.floor(deviceHeight * scale) + 'px';
          }
          scaleToFit();
          window.addEventListener('resize', scaleToFit);
        })();
      </script>
      <% if has_screenshot %>
        <script>
          (function() {
            var btn = document.getElementById('regen-screenshot-btn');
            var img = document.getElementById('screenshot-img');
            var loading = document.getElementById('screenshot-loading');
            btn.addEventListener('click', function() {
              btn.disabled = true;
              btn.textContent = 'Regenerating\u2026';
              img.style.display = 'none';
              loading.style.display = '';
              var newImg = new Image();
              newImg.onload = function() {
                img.src = newImg.src;
                img.style.display = '';
                loading.style.display = 'none';
                btn.disabled = false;
                btn.textContent = 'Regenerate';
              };
              newImg.onerror = function() {
                loading.textContent = 'Failed to regenerate screenshot.';
                btn.disabled = false;
                btn.textContent = 'Regenerate';
              };
              newImg.src = '<%= screenshot_account_location_device_path(@account, @location, @device) %>' + '?force=true&_=' + Date.now();
            });
          })();
        </script>
      <% end %>
    </div>

    <%# Rename %>
    <div class="card mb-3">
      <%= form_with url: rename_account_location_device_path(@account, @location, @device), method: :patch do %>
        <div class="card-header d-flex align-items-center justify-content-between py-2">
          <span class="small text-body-secondary">Device Name</span>
          <%= submit_tag "Save", class: "btn btn-primary btn-sm" %>
        </div>
        <div class="card-body">
          <input type="text" name="name" value="<%= @device.name %>" class="form-control" required>
        </div>
      <% end %>
    </div>

    <% if defined?(current_user) && current_user&.is_admin? %>
      <%# Admin: Reassign to another location %>
      <div class="card mb-3 border-warning">
        <%= form_with url: reassign_account_location_device_path(@account, @location, @device), method: :patch do %>
          <div class="card-header d-flex align-items-center justify-content-between py-2 bg-warning-subtle">
            <span class="small text-body-secondary">Admin: Reassign Location</span>
            <%= submit_tag "Reassign", class: "btn btn-warning btn-sm" %>
          </div>
          <div class="card-body">
            <select name="target_location_id" class="form-select" required>
              <% Account.includes(:locations).order(:name).each do |acct| %>
                <% next if acct.locations.empty? %>
                <optgroup label="<%= acct.name %>">
                  <% acct.locations.order(:name).each do |loc| %>
                    <% if loc.id == @device.location_id %>
                      <option value="<%= loc.id %>" selected><%= loc.name %> (current)</option>
                    <% else %>
                      <option value="<%= loc.id %>"><%= loc.name %></option>
                    <% end %>
                  <% end %>
                </optgroup>
              <% end %>
            </select>
            <p class="form-text mb-0">Move this device to a different account or location.</p>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Template selection %>
    <% if @device.template_options %>
      <div class="card mb-3">
        <div class="card-header py-2">
          <span class="small text-body-secondary">Display Template</span>
        </div>
        <div class="card-body">
          <div class="list-group list-group-flush">
            <% @device.template_options.each do |tmpl| %>
              <%= form_with url: update_template_account_location_device_path(@account, @location, @device), method: :patch do %>
                <input type="hidden" name="display_template" value="<%= tmpl[:name] %>">
                <button type="submit" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center<%= ' active' if @device.active_template == tmpl[:name] %>">
                  <%= tmpl[:label] %>
                  <% if @device.active_template == tmpl[:name] %>
                    <i class="mdi mdi-check"></i>
                  <% end %>
                </button>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# Display options %>
    <% if @device.active_template.present? %>
      <div class="card mb-3">
        <div class="card-header py-2">
          <span class="small text-body-secondary">Display Options</span>
        </div>
        <div class="card-body">
          <% options = [] %>
          <% one_day_template = @device.active_template == "one_day" %>
          <% compact_template = %w[two_day three_day one_day].include?(@device.active_template) %>
          <% if compact_template %>
            <% options << {key: "only_show_events_with_icons", on_label: "Only Show Calendar Events with Icons", off_label: "Only Show Calendar Events with Icons", default_on: false} %>
          <% end %>
          <% show_hourly_conditions = !one_day_template && @device.active_template != "two_day" %>
          <% if show_hourly_conditions %>
            <% options << {key: "show_temperature_events", on_label: "Hourly Conditions", off_label: "Hourly Conditions", default_on: true} %>
          <% end %>
          <% unless one_day_template %>
            <% options << {key: "show_precip_events", on_label: "Precipitation Events", off_label: "Precipitation Events", default_on: true} %>
            <% options << {key: "show_wind_events", on_label: "Wind Events", off_label: "Wind Events", default_on: true} %>
          <% end %>
          <% if compact_template %>
            <% unless one_day_template %>
              <% options << {key: "clothing_forecast", on_label: "Clothing Forecast", off_label: "Clothing Forecast", default_on: false} %>
              <% options << {key: "show_icons", on_label: "Icons", off_label: "Icons", default_on: true} %>
            <% end %>
            <% if one_day_template || @device.configuration&.dig("show_icons") != "false" %>
              <% options << {key: "auto_assign_icons", on_label: "Auto Assign Icons", off_label: "Auto Assign Icons", default_on: true} %>
            <% end %>
            <% if @device.active_template == "two_day" %>
              <% options << {key: "show_dates", on_label: "Dates", off_label: "Dates", default_on: true} %>
              <% options << {key: "show_event_times", on_label: "Event Times", off_label: "Event Times", default_on: true} %>
              <% options << {key: "two_day_rollover_enabled", on_label: "Hide Current Day After Time", off_label: "Hide Current Day After Time", default_on: false} %>
            <% end %>
            <% if one_day_template %>
              <% options << {key: "one_day_rollover_enabled", on_label: "Hide Current Day After Time", off_label: "Hide Current Day After Time", default_on: false} %>
            <% end %>
          <% end %>
          <% if Device::HIDE_CURRENT_DAY_TEMPLATES.include?(@device.active_template) %>
            <% options << {key: "hide_current_day_enabled", on_label: "Hide Current Day After Time", off_label: "Hide Current Day After Time", default_on: @device.hide_current_day_default_on?} %>
          <% end %>
          <% options.each do |opt| %>
            <%
              current_value = @device.configuration&.dig(opt[:key])
              is_on = opt[:default_on] ? current_value != "false" : current_value == "true"
              new_value = is_on ? "false" : "true"
            %>
            <%= form_with url: update_configuration_account_location_device_path(@account, @location, @device), method: :patch do %>
              <input type="hidden" name="key" value="<%= opt[:key] %>">
              <input type="hidden" name="value" value="<%= new_value %>">
              <div class="form-check form-switch mb-2">
                <% if is_on %>
                  <input type="checkbox" class="form-check-input" role="switch" style="cursor: pointer;" checked onchange="this.form.submit()">
                <% else %>
                  <input type="checkbox" class="form-check-input" role="switch" style="cursor: pointer;" onchange="this.form.submit()">
                <% end %>
                <label class="form-check-label"><%= opt[:on_label] %></label>
              </div>
            <% end %>
            <% if opt[:key] == "show_temperature_events" && is_on %>
              <% selected_hours = @device.temperature_event_hours %>
              <div class="mb-2 ms-4">
                <div class="d-flex flex-wrap gap-1">
                  <% (0..23).each do |hour| %>
                    <% checked = selected_hours.include?(hour) %>
                    <% hour_new_value = checked ? "false" : "true" %>
                    <% label = Time.new(2000, 1, 1, hour).strftime("%-l%P") %>
                    <%= form_with url: update_configuration_account_location_device_path(@account, @location, @device), method: :patch, class: "m-0" do %>
                      <input type="hidden" name="key" value="temperature_hour_<%= hour %>">
                      <input type="hidden" name="value" value="<%= hour_new_value %>">
                      <button type="submit" class="btn btn-sm <%= checked ? "btn-primary" : "btn-outline-secondary" %>" style="min-width: 2.5rem; padding: 0.15rem 0.4rem; font-size: 0.75rem;">
                        <%= label %>
                      </button>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
            <% if opt[:key] == "show_wind_events" && is_on %>
              <%
                display_unit = (@device.account&.respond_to?(:speed_unit) && @device.account&.speed_unit == "kph") ? "kph" : "mph"
                threshold_mph = @device.wind_gust_threshold_mph
                display_value = (display_unit == "kph") ? (threshold_mph * 1.609344).round : threshold_mph.round
              %>
              <div class="mb-2 ms-4">
                <%= form_with url: update_configuration_account_location_device_path(@account, @location, @device), method: :patch, class: "d-flex align-items-center gap-2" do %>
                  <input type="hidden" name="key" value="wind_gust_threshold_mph">
                  <input type="hidden" name="unit" value="<%= display_unit %>">
                  <label class="form-label small mb-0">Gust threshold</label>
                  <div class="input-group input-group-sm" style="max-width: 10rem;">
                    <input type="number" min="1" step="1" name="value" value="<%= display_value %>" class="form-control">
                    <span class="input-group-text"><%= display_unit %></span>
                    <%= submit_tag "Save", class: "btn btn-primary" %>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% end %>
          <% if @device.active_template == "two_day" && @device.configuration&.dig("two_day_rollover_enabled") == "true" %>
            <%= form_with url: update_configuration_account_location_device_path(@account, @location, @device), method: :patch, class: "mt-3" do %>
              <input type="hidden" name="key" value="two_day_rollover_time">
              <label class="form-label small mb-1" for="two-day-rollover-time">Hide Current Day After</label>
              <div class="input-group input-group-sm">
                <input
                  type="time"
                  id="two-day-rollover-time"
                  name="value"
                  value="<%= @device.configuration&.dig("two_day_rollover_time").presence || Device::TWO_DAY_DEFAULT_ROLLOVER_TIME %>"
                  class="form-control"
                >
                <%= submit_tag "Save", class: "btn btn-primary" %>
              </div>
            <% end %>
          <% end %>
          <% if @device.active_template == "one_day" && @device.configuration&.dig("one_day_rollover_enabled") == "true" %>
            <%= form_with url: update_configuration_account_location_device_path(@account, @location, @device), method: :patch, class: "mt-3" do %>
              <input type="hidden" name="key" value="one_day_rollover_time">
              <label class="form-label small mb-1" for="one-day-rollover-time">Hide Current Day After</label>
              <div class="input-group input-group-sm">
                <input
                  type="time"
                  id="one-day-rollover-time"
                  name="value"
                  value="<%= @device.configuration&.dig("one_day_rollover_time").presence || Device::TWO_DAY_DEFAULT_ROLLOVER_TIME %>"
                  class="form-control"
                >
                <%= submit_tag "Save", class: "btn btn-primary" %>
              </div>
            <% end %>
          <% end %>
          <% if Device::HIDE_CURRENT_DAY_TEMPLATES.include?(@device.active_template) && @device.hide_current_day_enabled? %>
            <%= form_with url: update_configuration_account_location_device_path(@account, @location, @device), method: :patch, class: "mt-3" do %>
              <input type="hidden" name="key" value="hide_current_day_time">
              <label class="form-label small mb-1" for="hide-current-day-time">Hide Current Day After</label>
              <div class="input-group input-group-sm">
                <input
                  type="time"
                  id="hide-current-day-time"
                  name="value"
                  value="<%= @device.configuration&.dig("hide_current_day_time").presence || Device::HIDE_CURRENT_DAY_DEFAULT_TIME %>"
                  class="form-control"
                >
                <%= submit_tag "Save", class: "btn btn-primary" %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Event filter %>
    <div class="card mb-3">
      <%= form_with url: update_configuration_account_location_device_path(@account, @location, @device), method: :patch do %>
        <input type="hidden" name="key" value="event_filter">
        <div class="card-header d-flex align-items-center justify-content-between py-2">
          <span class="small text-body-secondary">Event Filter</span>
          <%= submit_tag "Save", class: "btn btn-primary btn-sm" %>
        </div>
        <div class="card-body">
          <p class="small text-body-secondary mb-2">Only show calendar events matching these keywords (comma-separated). Leave blank to show all events.</p>
          <input type="text" name="value" value="<%= @device.configuration&.dig("event_filter") %>" class="form-control" placeholder="e.g. soccer, piano, dentist">
        </div>
      <% end %>
    </div>

    <% if lookup_context.template_exists?("calendars", "devices", true) %>
      <%= render "devices/calendars" %>
    <% end %>

    <% if lookup_context.template_exists?("event_icons", "devices", true) %>
      <%= render "devices/event_icons" %>
    <% end %>

    <% admin_context = !defined?(current_user) || current_user&.is_admin? %>
    <% if admin_context %>
      <div class="card mb-3">
        <div class="card-header py-2">
          <span class="small text-body-secondary">Admin</span>
        </div>
        <div class="card-body">
          <%= form_with url: account_location_device_path(@account, @location, @device), method: :patch do %>
            <div class="form-check form-switch mb-2">
              <% if @device.demo_mode_enabled? %>
                <input type="checkbox" class="form-check-input" role="switch" style="cursor: pointer;" checked onchange="this.form.submit()">
              <% else %>
                <input type="checkbox" class="form-check-input" role="switch" style="cursor: pointer;" onchange="this.form.submit()">
              <% end %>
              <label class="form-check-label">Demo Mode</label>
            </div>
          <% end %>
          <% if defined?(current_user) && current_user&.is_admin? %>
            <div class="d-flex gap-2">
              <% if respond_to?(:admin_device_path) %>
                <%= link_to "Audit Log", admin_device_path(@device), class: "btn btn-outline-secondary btn-sm" %>
              <% end %>
              <% if @device.screenshotted? %>
                <a href="<%= screenshot_account_location_device_path(@account, @location, @device) %>" class="btn btn-outline-secondary btn-sm">Screenshot</a>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Token URL %>
    <% if @device.visionect? && @device.display_key.present? %>
      <div class="card mb-3">
        <div class="card-header py-2">
          <span class="small text-body-secondary">Token URL</span>
        </div>
        <div class="card-body">
          <div class="input-group mb-2">
            <input type="text" class="form-control form-control-sm" value="<%= @device.token_device_url(host: request.base_url) %>" readonly id="token-url-<%= @device.id %>">
            <button class="btn btn-outline-secondary btn-sm" type="button" onclick="var el=document.getElementById('token-url-<%= @device.id %>'); navigator.clipboard.writeText(el.value).then(function(){alert('Copied!')})">Copy</button>
          </div>
          <button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="collapse" data-bs-target="#regen-<%= @device.id %>">Regenerate URL</button>
          <div class="collapse mt-2" id="regen-<%= @device.id %>">
            <%= form_with url: regenerate_tokens_account_location_device_path(@account, @location, @device), method: :post do %>
              <p class="small text-muted">This will invalidate the current token URL. Type <strong><%= @device.name %></strong> to confirm.</p>
              <div class="input-group">
                <input type="text" name="name_confirmation" class="form-control form-control-sm" placeholder="<%= @device.name %>" autocomplete="off" data-regen-input="<%= @device.id %>">
                <%= submit_tag "Regenerate", class: "btn btn-warning btn-sm", disabled: true, id: "regen-btn-#{@device.id}" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <script>
        (function() {
          var input = document.querySelector('[data-regen-input="<%= @device.id %>"]');
          var btn = document.getElementById('regen-btn-<%= @device.id %>');
          input.addEventListener('input', function() {
            btn.disabled = input.value.toLowerCase().trim() !== '<%= @device.name.downcase.gsub("'", "\\'") %>'.toLowerCase();
          });
        })();
      </script>
    <% end %>

    <%# Reconnect %>
    <% if @device.pairing_code_device? && @device.disconnected? %>
      <div class="card mb-3">
        <div class="card-header py-2">
          <span class="small text-body-secondary">Reconnect</span>
        </div>
        <div class="card-body">
          <% if @device.reterminal_e1003? %>
            <p class="small text-muted">On your reTerminal, reconnect to the API server at <code><%= request.base_url %></code> to get a new pairing code.</p>
          <% elsif @device.trmnl? || @device.reterminal_e1001? %>
            <p class="small text-muted">On your device, reconnect to the API server at <code><%= request.base_url %></code> to get a new pairing code.</p>
          <% else %>
            <p class="small text-muted">On your device, visit <code><%= request.base_url %>/pair</code> to get a new pairing code.</p>
          <% end %>
          <%= form_with url: repair_account_location_device_path(@account, @location, @device), method: :post do %>
            <div class="input-group">
              <input type="text" name="pairing_code" class="form-control form-control-sm" placeholder="e.g. 123456" autocomplete="off" inputmode="numeric" minlength="6" maxlength="6" pattern="[0-9]{6}" data-repair-input="<%= @device.id %>">
              <%= submit_tag "Reconnect", class: "btn btn-primary btn-sm", disabled: true, id: "repair-btn-#{@device.id}" %>
            </div>
          <% end %>
        </div>
      </div>
      <script>
        (function() {
          var input = document.querySelector('[data-repair-input="<%= @device.id %>"]');
          var btn = document.getElementById('repair-btn-<%= @device.id %>');
          input.addEventListener('input', function() {
            btn.disabled = !/^[0-9]{6}$/.test(input.value);
          });
        })();
      </script>
    <% end %>

    <%# Danger zone %>
    <div class="card mb-3 border-danger">
      <div class="card-header py-2 border-danger">
        <span class="small text-danger">Delete Device</span>
      </div>
      <div class="card-body">
        <p class="small text-muted">Type <strong><%= @device.name %></strong> to confirm deletion.</p>
        <%= form_with url: account_location_device_path(@account, @location, @device), method: :delete do %>
          <div class="input-group">
            <input type="text" name="name_confirmation" class="form-control form-control-sm" placeholder="<%= @device.name %>" autocomplete="off" data-delete-input="<%= @device.id %>">
            <%= submit_tag "Delete Device", class: "btn btn-danger btn-sm", disabled: true, id: "delete-btn-#{@device.id}" %>
          </div>
        <% end %>
      </div>
    </div>
    <script>
      (function() {
        var input = document.querySelector('[data-delete-input="<%= @device.id %>"]');
        var btn = document.getElementById('delete-btn-<%= @device.id %>');
        input.addEventListener('input', function() {
          btn.disabled = input.value.toLowerCase().trim() !== '<%= @device.name.downcase.gsub("'", "\\'") %>'.toLowerCase();
        });
      })();
    </script>
  </div>
</div>
