<% content_for :title, @device.name %>
<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <% if defined?(current_user) && current_user&.is_admin? %>
      <% admin_user = @device.account&.users&.first %>
      <% if admin_user %>
        <p class="mb-1"><%= link_to "← Back to #{admin_user.email}", admin_user_path(admin_user), class: "text-decoration-none small" %></p>
      <% end %>
    <% end %>
    <div class="d-flex align-items-center mb-4">
      <h3 class="mb-0"><%= @device.name %></h3>
      <% unless defined?(current_user) && current_user && !current_user.is_admin? %>
        <span class="text-body-tertiary ms-2" style="font-size: 0.85rem;"><%= @device.model_name_label %></span>
      <% end %>
      <% if defined?(current_user) && current_user&.is_admin? %>
        <span class="badge text-bg-secondary ms-2" style="font-size: 0.7rem;">ID #<%= @device.id %></span>
      <% end %>
    </div>

    <%# Preview + Screenshot %>
    <% has_screenshot = @device.screenshotted? && @device.cached_image.present? %>
    <div class="card mb-3">
      <div class="card-header preview-tabs-header">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button type="button" class="nav-link active" id="preview-tab" data-bs-toggle="tab" data-bs-target="#preview-pane" role="tab" aria-controls="preview-pane" aria-selected="true">Preview</button>
          </li>
          <% if has_screenshot %>
            <li class="nav-item" role="presentation">
              <button type="button" class="nav-link" id="screenshot-tab" data-bs-toggle="tab" data-bs-target="#screenshot-pane" role="tab" aria-controls="screenshot-pane" aria-selected="false">Screenshot</button>
            </li>
          <% end %>
        </ul>
      </div>
      <style>
        .preview-tabs-header .nav-link { color: var(--bs-body-color); }
        .preview-tabs-header .nav-link:hover,
        .preview-tabs-header .nav-link:focus { color: var(--bs-body-color); }
        .preview-tabs-header .nav-link.active { color: var(--bs-body-color); }
      </style>
      <div class="tab-content">
        <div class="tab-pane fade show active" id="preview-pane" role="tabpanel" aria-labelledby="preview-tab">
          <div class="card-body p-0">
            <div id="preview-container" style="position: relative; background: white; overflow: hidden; width: 100%;">
              <iframe
                id="preview-iframe"
                src="<%= preview_frame_account_location_device_path(@account, @location, @device) %>"
                width="<%= @device.display_width %>"
                height="<%= @device.display_height %>"
                scrolling="no"
                style="border: none; position: absolute; top: 0; left: 0; width: <%= @device.display_width %>px; height: <%= @device.display_height %>px; transform-origin: top left;"
              ></iframe>
            </div>
          </div>
          <div class="card-footer py-2">
            <div class="d-flex flex-wrap align-items-center gap-1">
              <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-secondary" id="preview-prev" title="Previous day">&larr;</button>
                <button type="button" class="btn btn-outline-secondary" id="preview-today">Today</button>
                <button type="button" class="btn btn-outline-secondary" id="preview-next" title="Next day">&rarr;</button>
              </div>
              <input type="date" class="form-control form-control-sm w-auto flex-shrink-0" id="preview-date" value="<%= @preview_now.to_date.to_s %>">
              <input type="time" class="form-control form-control-sm w-auto flex-shrink-0" id="preview-time" value="<%= @preview_now.strftime("%H:%M") %>">
            </div>
          </div>
        </div>
        <% if has_screenshot %>
          <div class="tab-pane fade" id="screenshot-pane" role="tabpanel" aria-labelledby="screenshot-tab">
            <div class="card-body p-2">
              <div class="d-flex align-items-center justify-content-center" style="background: #f0f0f0; border-radius: .25rem; overflow: hidden; min-height: 100px;" id="screenshot-container">
                <% if @device.reterminal_e1003? || @device.trmnl_x? %>
                  <%# Portrait panel (display_width x display_height) shown rotated -90deg.
                      CSS rotation doesn't change the layout box, so wrap the image in an
                      aspect-ratio box sized for the rotated (landscape) result and center
                      the rotated image inside it so nothing gets clipped. %>
                  <% rotated_pct = (@device.display_width.to_f / @device.display_height * 100).round(2) %>
                  <div style="position: relative; width: 100%; padding-bottom: <%= rotated_pct %>%;">
                    <img src="<%= screenshot_account_location_device_path(@account, @location, @device) %>" alt="<%= @device.name %>" style="position: absolute; top: 50%; left: 50%; width: <%= rotated_pct %>%; height: auto; transform: translate(-50%, -50%) rotate(-90deg);" id="screenshot-img">
                  </div>
                <% else %>
                  <img src="<%= screenshot_account_location_device_path(@account, @location, @device) %>" alt="<%= @device.name %>" style="max-width: 100%; height: auto;" id="screenshot-img">
                <% end %>
                <div id="screenshot-loading" style="display: none;" class="text-body-secondary small py-4">Regenerating screenshot&hellip;</div>
              </div>
            </div>
            <div class="card-footer py-2 d-flex justify-content-between align-items-center">
              <span class="text-body-tertiary small" id="screenshot-generated-at">
                <% if @device.cached_image_at %>
                  Generated <%= (@device.cached_image_at > 1.minute.ago) ? "<1m" : time_ago_in_words(@device.cached_image_at) %> ago
                <% end %>
              </span>
              <button type="button" class="btn btn-outline-secondary btn-sm" id="regen-screenshot-btn">Regenerate</button>
            </div>
          </div>
        <% end %>
      </div>
      <script>
        (function() {
          var basePath = '<%= preview_frame_account_location_device_path(@account, @location, @device) %>';
          var dateInput = document.getElementById('preview-date');
          var timeInput = document.getElementById('preview-time');
          var prevBtn = document.getElementById('preview-prev');
          var nextBtn = document.getElementById('preview-next');
          var todayBtn = document.getElementById('preview-today');
          var container = document.getElementById('preview-container');
          var iframe = document.getElementById('preview-iframe');
          var deviceWidth = <%= @device.display_width %>;
          var deviceHeight = <%= @device.display_height %>;
          function updatePreview() {
            var at = dateInput.value + 'T' + timeInput.value + ':00';
            iframe.src = basePath + '?at=' + encodeURIComponent(at);
          }
          function shiftDate(days) {
            var d = new Date(dateInput.value + 'T12:00:00');
            d.setDate(d.getDate() + days);
            dateInput.value = d.toISOString().slice(0, 10);
            updatePreview();
          }
          prevBtn.addEventListener('click', function() { shiftDate(-1); });
          nextBtn.addEventListener('click', function() { shiftDate(1); });
          todayBtn.addEventListener('click', function() {
            dateInput.value = '<%= @preview_now.to_date.to_s %>';
            timeInput.value = '<%= @preview_now.strftime("%H:%M") %>';
            updatePreview();
          });
          dateInput.addEventListener('change', updatePreview);
          timeInput.addEventListener('change', updatePreview);
          function scaleToFit() {
            var availWidth = container.parentElement.clientWidth;
            var scale = availWidth / deviceWidth;
            iframe.style.transform = 'scale(' + scale + ')';
            container.style.height = Math.floor(deviceHeight * scale) + 'px';
          }
          scaleToFit();
          window.addEventListener('resize', scaleToFit);
        })();
      </script>
      <% if has_screenshot %>
        <script>
          (function() {
            var btn = document.getElementById('regen-screenshot-btn');
            var img = document.getElementById('screenshot-img');
            var loading = document.getElementById('screenshot-loading');
            btn.addEventListener('click', function() {
              btn.disabled = true;
              btn.textContent = 'Regenerating\u2026';
              img.style.display = 'none';
              loading.style.display = '';
              var newImg = new Image();
              newImg.onload = function() {
                img.src = newImg.src;
                img.style.display = '';
                loading.style.display = 'none';
                btn.disabled = false;
                btn.textContent = 'Regenerate';
              };
              newImg.onerror = function() {
                loading.textContent = 'Failed to regenerate screenshot.';
                btn.disabled = false;
                btn.textContent = 'Regenerate';
              };
              newImg.src = '<%= screenshot_account_location_device_path(@account, @location, @device) %>' + '?force=true&_=' + Date.now();
            });
          })();
        </script>
      <% end %>
    </div>

    <%# Options %>
    <div class="card mb-3">
      <%= form_with url: update_options_account_location_device_path(@account, @location, @device), method: :patch, id: "device-options-form" do %>
        <div class="card-header d-flex align-items-center justify-content-between py-2">
          <span class="small text-body-secondary">Options</span>
          <%= submit_tag "Save", class: "btn btn-primary btn-sm" %>
        </div>
        <div class="card-body">
        <%# Name %>
        <label class="form-label small fw-bold mb-1" for="device-name">Name</label>
        <input type="text" id="device-name" name="name" value="<%= @device.name %>" class="form-control form-control-sm mb-3" required>

        <%# Template selection (applies on change) %>
        <% if @device.template_options %>
          <label class="form-label small fw-bold mb-1">Layout</label>
          <div class="list-group list-group-flush border rounded mb-3">
            <% @device.template_options.each do |tmpl| %>
              <label class="list-group-item list-group-item-action d-flex justify-content-between align-items-center<%= ' active' if @device.active_template == tmpl[:name] %>" style="cursor: pointer;">
                <span class="d-flex align-items-center gap-2">
                  <%= radio_button_tag "display_template", tmpl[:name], @device.active_template == tmpl[:name], class: "form-check-input mt-0", onchange: "this.form.submit()" %>
                  <%= tmpl[:label] %>
                </span>
                <% if @device.active_template == tmpl[:name] %>
                  <i class="mdi mdi-check"></i>
                <% end %>
              </label>
            <% end %>
          </div>
        <% end %>

        <% if @device.active_template.present? %>
          <%= render "devices/options_fields", device: @device %>
        <% end %>

        <%# Calendars %>
        <% if lookup_context.template_exists?("calendars", "devices", true) %>
          <%= render "devices/calendars" %>
        <% end %>
        </div>
      <% end %>
    </div>
    <script>
      (function() {
        var form = document.getElementById('device-options-form');
        if (!form) return;
        function syncDependents() {
          form.querySelectorAll('[data-depends-on]').forEach(function(el) {
            var key = el.getAttribute('data-depends-on');
            if (!key) return;
            var cb = form.querySelector('[data-option-key="' + key + '"]');
            el.style.display = (cb && cb.checked) ? '' : 'none';
          });
        }
        form.querySelectorAll('[data-option-key]').forEach(function(cb) {
          cb.addEventListener('change', syncDependents);
        });
        syncDependents();
      })();
    </script>

    <% admin_context = !defined?(current_user) || current_user&.is_admin? %>
    <% if admin_context %>
      <div class="card mb-3 border-warning">
        <div class="card-header py-2 bg-warning-subtle">
          <span class="small text-body-secondary">Admin</span>
        </div>
        <div class="card-body">
          <%= form_with url: account_location_device_path(@account, @location, @device), method: :patch do %>
            <div class="form-check form-switch mb-2">
              <% if @device.demo_mode_enabled? %>
                <input type="checkbox" class="form-check-input" role="switch" style="cursor: pointer;" checked onchange="this.form.submit()">
              <% else %>
                <input type="checkbox" class="form-check-input" role="switch" style="cursor: pointer;" onchange="this.form.submit()">
              <% end %>
              <label class="form-check-label">Demo mode</label>
            </div>
          <% end %>
          <% if defined?(current_user) && current_user&.is_admin? %>
            <%= form_with url: reassign_account_location_device_path(@account, @location, @device), method: :patch, class: "mb-3" do %>
              <label class="form-label small mb-1" for="reassign-location">Reassign location</label>
              <div class="input-group input-group-sm">
                <select name="target_location_id" id="reassign-location" class="form-select" required>
                  <% Account.includes(:locations).order(:name).each do |acct| %>
                    <% next if acct.locations.empty? %>
                    <optgroup label="<%= acct.name %>">
                      <% acct.locations.order(:name).each do |loc| %>
                        <% if loc.id == @device.location_id %>
                          <option value="<%= loc.id %>" selected><%= loc.name %> (current)</option>
                        <% else %>
                          <option value="<%= loc.id %>"><%= loc.name %></option>
                        <% end %>
                      <% end %>
                    </optgroup>
                  <% end %>
                </select>
                <%= submit_tag "Reassign", class: "btn btn-warning" %>
              </div>
              <p class="form-text mb-0">Move this device to a different account or location.</p>
            <% end %>
            <div class="d-flex gap-2">
              <% if respond_to?(:admin_device_path) %>
                <%= link_to "Audit Log", admin_device_path(@device), class: "btn btn-outline-secondary btn-sm" %>
              <% end %>
              <% if @device.screenshotted? %>
                <a href="<%= screenshot_account_location_device_path(@account, @location, @device) %>" class="btn btn-outline-secondary btn-sm">Screenshot</a>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Token URL %>
    <% if @device.visionect? && @device.display_key.present? %>
      <div class="card mb-3">
        <div class="card-header py-2">
          <span class="small text-body-secondary">Token URL</span>
        </div>
        <div class="card-body">
          <div class="input-group mb-2">
            <input type="text" class="form-control form-control-sm" value="<%= @device.token_device_url(host: request.base_url) %>" readonly id="token-url-<%= @device.id %>">
            <button class="btn btn-outline-secondary btn-sm" type="button" onclick="var el=document.getElementById('token-url-<%= @device.id %>'); navigator.clipboard.writeText(el.value).then(function(){alert('Copied!')})">Copy</button>
          </div>
          <button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="collapse" data-bs-target="#regen-<%= @device.id %>">Regenerate URL</button>
          <div class="collapse mt-2" id="regen-<%= @device.id %>">
            <%= form_with url: regenerate_tokens_account_location_device_path(@account, @location, @device), method: :post do %>
              <p class="small text-muted">This will invalidate the current token URL. Type <strong><%= @device.name %></strong> to confirm.</p>
              <div class="input-group">
                <input type="text" name="name_confirmation" class="form-control form-control-sm" placeholder="<%= @device.name %>" autocomplete="off" data-regen-input="<%= @device.id %>">
                <%= submit_tag "Regenerate", class: "btn btn-warning btn-sm", disabled: true, id: "regen-btn-#{@device.id}" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <script>
        (function() {
          var input = document.querySelector('[data-regen-input="<%= @device.id %>"]');
          var btn = document.getElementById('regen-btn-<%= @device.id %>');
          input.addEventListener('input', function() {
            btn.disabled = input.value.toLowerCase().trim() !== '<%= @device.name.downcase.gsub("'", "\\'") %>'.toLowerCase();
          });
        })();
      </script>
    <% end %>

    <%# Reconnect %>
    <% if @device.pairing_code_device? && @device.disconnected? %>
      <div class="card mb-3">
        <div class="card-header py-2">
          <span class="small text-body-secondary">Reconnect</span>
        </div>
        <div class="card-body">
          <% if @device.trmnl? || @device.reterminal_e1001? %>
            <p class="small text-muted">On your device, reconnect to the API server at <code><%= request.base_url %></code> to get a new pairing code.</p>
          <% else %>
            <p class="small text-muted">On your device, visit <code><%= request.base_url %>/pair</code> to get a new pairing code.</p>
          <% end %>
          <%= form_with url: repair_account_location_device_path(@account, @location, @device), method: :post do %>
            <div class="input-group">
              <input type="text" name="pairing_code" class="form-control form-control-sm" placeholder="e.g. 123456" autocomplete="off" inputmode="numeric" minlength="6" maxlength="6" pattern="[0-9]{6}" data-repair-input="<%= @device.id %>">
              <%= submit_tag "Reconnect", class: "btn btn-primary btn-sm", disabled: true, id: "repair-btn-#{@device.id}" %>
            </div>
          <% end %>
        </div>
      </div>
      <script>
        (function() {
          var input = document.querySelector('[data-repair-input="<%= @device.id %>"]');
          var btn = document.getElementById('repair-btn-<%= @device.id %>');
          input.addEventListener('input', function() {
            btn.disabled = !/^[0-9]{6}$/.test(input.value);
          });
        })();
      </script>
    <% end %>

    <%# Danger zone %>
    <div class="card mb-3 border-danger">
      <div class="card-header py-2 border-danger">
        <span class="small text-danger">Delete Device</span>
      </div>
      <div class="card-body">
        <p class="small text-muted">Type <strong><%= @device.name %></strong> to confirm deletion.</p>
        <%= form_with url: account_location_device_path(@account, @location, @device), method: :delete do %>
          <div class="input-group">
            <input type="text" name="name_confirmation" class="form-control form-control-sm" placeholder="<%= @device.name %>" autocomplete="off" data-delete-input="<%= @device.id %>">
            <%= submit_tag "Delete Device", class: "btn btn-danger btn-sm", disabled: true, id: "delete-btn-#{@device.id}" %>
          </div>
        <% end %>
      </div>
    </div>
    <script>
      (function() {
        var input = document.querySelector('[data-delete-input="<%= @device.id %>"]');
        var btn = document.getElementById('delete-btn-<%= @device.id %>');
        input.addEventListener('input', function() {
          btn.disabled = input.value.toLowerCase().trim() !== '<%= @device.name.downcase.gsub("'", "\\'") %>'.toLowerCase();
        });
      })();
    </script>
  </div>
</div>
