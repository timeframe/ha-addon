<%# Template-aware device option switches, shared by the device settings page
    and the onboarding "Configure" step. Expects a `device` local. Render inside
    a form that posts to update_options (or the onboarding equivalent). %>
<% if device.active_template.present? %>
  <% options = [] %>
  <% one_day_template = device.active_template == "one_day" %>
  <% trmnl_template = device.active_template == "trmnl" %>
  <% compact_template = %w[two_day three_day one_day].include?(device.active_template) %>
  <% if %w[trmnl reterminal thirteen boox_mira mira].include?(device.active_template) %>
    <% options << {key: "show_current_day", on_label: "Current date & temperature", off_label: "Current date & temperature", default_on: device.active_template != "trmnl"} %>
  <% end %>
  <% if compact_template %>
    <% options << {key: "only_show_events_with_icons", on_label: "Only show calendar events with icons", off_label: "Only show calendar events with icons", default_on: false} %>
  <% end %>
  <% show_hourly_conditions = !one_day_template && device.active_template != "two_day" %>
  <% if show_hourly_conditions %>
    <% options << {key: "show_temperature_events", on_label: "Hourly conditions", off_label: "Hourly conditions", default_on: true} %>
  <% end %>
  <% unless one_day_template %>
    <% options << {key: "show_precip_events", on_label: "Precipitation events", off_label: "Precipitation events", default_on: true} %>
    <% options << {key: "show_wind_events", on_label: "Wind events", off_label: "Wind events", default_on: true} %>
  <% end %>
  <% options << {key: "show_weather_alerts", on_label: "Weather alerts", off_label: "Weather alerts", default_on: !%w[one_day two_day].include?(device.active_template)} %>
  <% if trmnl_template %>
    <% options << {key: "auto_assign_icons", on_label: "Auto-assign icons based on event title", off_label: "Auto-assign icons based on event title", default_on: true} %>
    <% options << {key: "show_dates", on_label: "Dates", off_label: "Dates", default_on: false} %>
    <% options << {key: "clothing_forecast", on_label: "Clothing forecast", off_label: "Clothing forecast", default_on: false} %>
  <% end %>
  <% if compact_template %>
    <% unless one_day_template %>
      <% options << {key: "clothing_forecast", on_label: "Clothing forecast", off_label: "Clothing forecast", default_on: false} %>
    <% end %>
    <% options << {key: "show_icons", on_label: "Icons", off_label: "Icons", default_on: true} %>
    <% options << {key: "auto_assign_icons", on_label: "Auto-assign icons based on event title", off_label: "Auto-assign icons based on event title", default_on: true, depends_on: "show_icons"} %>
    <% if device.active_template == "two_day" %>
      <% options << {key: "show_dates", on_label: "Dates", off_label: "Dates", default_on: true} %>
      <% options << {key: "show_event_times", on_label: "Event times", off_label: "Event times", default_on: true} %>
      <% options << {key: "two_day_rollover_enabled", on_label: "Hide current day after time if no more events", off_label: "Hide current day after time if no more events", default_on: true} %>
    <% end %>
    <% if one_day_template %>
      <% options << {key: "show_event_times", on_label: "Event times", off_label: "Event times", default_on: false} %>
      <% options << {key: "one_day_rollover_enabled", on_label: "Hide current day after time if no more events", off_label: "Hide current day after time if no more events", default_on: true} %>
    <% end %>
  <% end %>
  <% if Device::HIDE_CURRENT_DAY_TEMPLATES.include?(device.active_template) %>
    <% options << {key: "hide_current_day_enabled", on_label: "Hide current day after time if no more events", off_label: "Hide current day after time if no more events", default_on: device.hide_current_day_default_on?} %>
  <% end %>
  <% options.each do |opt| %>
    <%
      current_value = device.configuration&.dig(opt[:key])
      is_on = opt[:default_on] ? current_value != "false" : current_value == "true"
    %>
    <div class="form-check form-switch mb-2" data-depends-on="<%= opt[:depends_on] %>">
      <input type="hidden" name="configuration[<%= opt[:key] %>]" value="false">
      <%= check_box_tag "configuration[#{opt[:key]}]", "true", is_on, class: "form-check-input", role: "switch", style: "cursor: pointer;", data: {"option-key": opt[:key]} %>
      <label class="form-check-label"><%= opt[:on_label] %></label>
    </div>
    <% if opt[:key] == "show_temperature_events" %>
      <% selected_hours = device.temperature_event_hours %>
      <div class="mb-2 ms-4" data-depends-on="show_temperature_events">
        <input type="hidden" name="temperature_hours_present" value="1">
        <div class="d-flex flex-wrap gap-1">
          <% (0..23).each do |hour| %>
            <% label = Time.new(2000, 1, 1, hour).strftime("%-l%P") %>
            <%= check_box_tag "temperature_hours[]", hour, selected_hours.include?(hour), id: "temp-hour-#{hour}", class: "btn-check", autocomplete: "off" %>
            <label class="btn btn-sm btn-outline-primary" for="temp-hour-<%= hour %>" style="min-width: 2.5rem; padding: 0.15rem 0.4rem; font-size: 0.75rem;"><%= label %></label>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if opt[:key] == "show_wind_events" %>
      <%
        display_unit = (device.account&.respond_to?(:speed_unit) && device.account&.speed_unit == "kph") ? "kph" : "mph"
        threshold_mph = device.wind_gust_threshold_mph
        display_value = (display_unit == "kph") ? (threshold_mph * 1.609344).round : threshold_mph.round
      %>
      <div class="mb-2 ms-4 d-flex align-items-center gap-2" data-depends-on="show_wind_events">
        <label class="form-label small mb-0" for="wind-gust-threshold">Gust threshold</label>
        <div class="input-group input-group-sm" style="max-width: 8rem;">
          <input type="number" min="1" step="1" id="wind-gust-threshold" name="configuration[wind_gust_threshold_mph]" value="<%= display_value %>" class="form-control">
          <input type="hidden" name="units[wind_gust_threshold_mph]" value="<%= display_unit %>">
          <span class="input-group-text"><%= display_unit %></span>
        </div>
      </div>
    <% end %>
  <% end %>
  <% if device.active_template == "two_day" %>
    <div class="mt-3" data-depends-on="two_day_rollover_enabled">
      <input type="time" id="two-day-rollover-time" name="configuration[two_day_rollover_time]" value="<%= device.configuration&.dig("two_day_rollover_time").presence || Device::TWO_DAY_DEFAULT_ROLLOVER_TIME %>" class="form-control form-control-sm" style="max-width: 10rem;">
    </div>
  <% end %>
  <% if device.active_template == "one_day" %>
    <div class="mt-3" data-depends-on="one_day_rollover_enabled">
      <input type="time" id="one-day-rollover-time" name="configuration[one_day_rollover_time]" value="<%= device.configuration&.dig("one_day_rollover_time").presence || Device::TWO_DAY_DEFAULT_ROLLOVER_TIME %>" class="form-control form-control-sm" style="max-width: 10rem;">
    </div>
  <% end %>
  <% if Device::HIDE_CURRENT_DAY_TEMPLATES.include?(device.active_template) %>
    <div class="mt-3" data-depends-on="hide_current_day_enabled">
      <input type="time" id="hide-current-day-time" name="configuration[hide_current_day_time]" value="<%= device.configuration&.dig("hide_current_day_time").presence || Device::HIDE_CURRENT_DAY_DEFAULT_TIME %>" class="form-control form-control-sm" style="max-width: 10rem;">
    </div>
  <% end %>
<% end %>
