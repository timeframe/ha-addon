#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../lib/release_preparation"

begin
  interactive = ARGV.empty?
  notes_path = nil
  OptionParser.new do |options|
    options.banner = "Usage: script/release [major|minor|patch] [--notes FILE]"
    options.on("--notes FILE", "Use already-generated changelog sections") { |path| notes_path = path }
    options.on("-h", "--help") do
      puts options
      exit
    end
  end.parse!

  release = ReleasePreparation.new
  bump = ARGV.shift
  raise ReleasePreparation::Error, "Unexpected arguments: #{ARGV.join(" ")}" unless ARGV.empty?

  if interactive
    puts "Current version: #{release.version}\n\nRelease type:"
    ReleasePreparation::BUMPS.each_with_index do |type, index|
      puts "  #{index + 1}) #{type} (#{release.next_version(type)})"
    end
    print "\nSelect [1/2/3]: "
    choice = $stdin.gets&.strip
    bump = {"1" => "major", "2" => "minor", "3" => "patch"}.fetch(choice, choice)
  end

  notes = File.read(notes_path) if notes_path
  version = release.prepare(bump, notes: notes)
  puts "\nUpdated config.json and CHANGELOG.md for v#{version}"
  puts "\nNext steps:\n  1. Review CHANGELOG.md\n  2. Run script/publish to commit, tag, and push"
rescue ReleasePreparation::Error, OptionParser::ParseError, JSON::ParserError, Errno::ENOENT => error
  warn "Release preparation failed: #{error.message}"
  exit 1
end
